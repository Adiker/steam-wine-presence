[Unit]
Description=Steam Wine Presence daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/steam-wine-presence
ExecStart=/usr/bin/node %h/steam-wine-presence/steam-presence-daemon.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
UMask=0077

[Install]
WantedBy=default.target
